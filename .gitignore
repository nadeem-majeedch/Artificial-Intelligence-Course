# ---------------------------------------------------------------------------
# Artificial Intelligence Course — repository ignore rules
# ---------------------------------------------------------------------------

# Freebuff workspace metadata (never part of the course)
.freebuff/

# Python bytecode, caches and coverage artefacts
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Local notebook execution outputs and temporary logs
*.nbconvert.ipynb
_*.log

# Local virtual environments
.venv/
venv/
env/
ENV/

# Packaging artefacts
build/
dist/
*.egg-info/

# Secrets and local configuration (never commit keys)
.env
.env.*
!.env.example
*.pem
*.key

# Downloaded or generated data that students should regenerate
datasets/**/raw/*.zip
datasets/**/raw/*.tar.gz
**/outputs/
**/figures/generated/

# Operating system and editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# LaTeX/Jupyter build leftovers
*.aux
*.log
*.toc
